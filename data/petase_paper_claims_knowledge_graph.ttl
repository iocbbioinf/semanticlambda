ent:Assay_duration a ahoj:Statistic ;
    rdfs:label "Assay duration" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:reportedValue 48 ;
    ahoj:unit "hours" .

ent:Assay_volume a ahoj:Statistic ;
    rdfs:label "Assay volume" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:reportedValue 0.5 ;
    ahoj:unit "mL" .

