    ahoj:unit "degree Celsius" .

ent:Minimum_assay_temperature a ahoj:Statistic ;
    rdfs:label "Minimum assay temperature" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
