claim:PETASE_P001 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P001: PETase research -- suffers from -- Protocol heterogeneity" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Protocol_heterogeneity ;
    ahoj:claimPredicate pred:suffers_from ;
    ahoj:claimSubject ent:PETase_research ;
    ahoj:claimText "PETase studies use diverse expression, purification, and assay protocols, making direct comparison of reported enzyme activities difficult." .

claim:PETASE_P002 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P002: Absence of standardized PETase protocol -- limits -- Comparability between studies" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Comparability_between_studies ;
    ahoj:claimPredicate pred:limits ;
    ahoj:claimSubject ent:Absence_of_standardized_PETase_protocol ;
    ahoj:claimText "The lack of a standardized PETase production protocol is a barrier to reliable enzyme characterization and comparison." .

claim:PETASE_P003 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P003: PETase standardized workflow -- addresses -- Expression and purification variability" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Expression_and_purification_variability ;
    ahoj:claimPredicate pred:addresses ;
    ahoj:claimSubject ent:PETase_standardized_workflow ;
    ahoj:claimText "The study presents a standardized workflow for expression, purification, and quality control of wild-type and engineered IsPETase variants." .

claim:PETASE_P004 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P004: PETase standardized workflow -- facilitates -- Activity comparison" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Activity_comparison ;
    ahoj:claimPredicate pred:facilitates ;
    ahoj:claimSubject ent:PETase_standardized_workflow ;
    ahoj:claimText "A unified production workflow enables more accurate comparison of PETase variants and improves reproducibility." .

claim:PETASE_P005 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P005: Enzymatic PET recycling -- supports -- Plastic waste management" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Plastic_waste_management ;
    ahoj:claimPredicate pred:supports ;
    ahoj:claimSubject ent:Enzymatic_PET_recycling ;
    ahoj:claimText "Enzymatic PET degradation is presented as an environmentally friendly route for mitigating plastic waste and enabling recycling." .

claim:PETASE_P006 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P006: PET -- is depolymerized into -- TPA" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:TPA ;
    ahoj:claimPredicate pred:is_depolymerized_into ;
    ahoj:claimSubject ent:PET ;
    ahoj:claimText "Enzymatic degradation of PET can release terephthalic acid as a monomeric product." .

claim:PETASE_P007 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P007: PET -- is depolymerized into -- EG" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:EG ;
    ahoj:claimPredicate pred:is_depolymerized_into ;
    ahoj:claimSubject ent:PET ;
    ahoj:claimText "Enzymatic degradation of PET can release ethylene glycol as a monomeric product." .

claim:PETASE_P008 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P008: Naturally occurring PETases -- exhibit -- Limited catalytic efficiency" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Limited_catalytic_efficiency ;
    ahoj:claimPredicate pred:exhibit ;
    ahoj:claimSubject ent:Naturally_occurring_PETases ;
    ahoj:claimText "Naturally occurring PETases, including IsPETase, have limited catalytic efficiency and therefore motivate engineering efforts." .

claim:PETASE_P009 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P009: Engineered PETase variants -- aim to improve -- Thermostability" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Thermostability ;
    ahoj:claimPredicate pred:aim_to_improve ;
    ahoj:claimSubject ent:Engineered_PETase_variants ;
    ahoj:claimText "Engineered PETase variants are designed to improve thermostability, substrate specificity, and degradation rate." .

claim:PETASE_P010 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P010: Five IsPETase variants -- were benchmarked by -- PETase standardized workflow" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:PETase_standardized_workflow ;
    ahoj:claimPredicate pred:were_benchmarked_by ;
    ahoj:claimSubject ent:Five_IsPETase_variants ;
    ahoj:claimText "The study benchmarks five IsPETase variants: WT, W185A, W159H/S238F, FAST-PETase, and HOT-PETase." .

claim:PETASE_P011 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P011: IsPETase WT -- is variant of -- IsPETase" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:IsPETase ;
    ahoj:claimPredicate pred:is_variant_of ;
    ahoj:claimSubject ent:IsPETase_WT ;
    ahoj:claimText "Wild-type IsPETase is used as the reference variant in the workflow." .

claim:PETASE_P012 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P012: PETase W185A -- is variant of -- IsPETase" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:IsPETase ;
    ahoj:claimPredicate pred:is_variant_of ;
    ahoj:claimSubject ent:PETase_W185A ;
    ahoj:claimText "W185A is a single-mutant IsPETase variant included in the comparison." .

claim:PETASE_P013 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P013: PETase W159H S238F -- is variant of -- IsPETase" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:IsPETase ;
    ahoj:claimPredicate pred:is_variant_of ;
    ahoj:claimSubject ent:PETase_W159H_S238F ;
    ahoj:claimText "W159H/S238F is a double-mutant IsPETase variant included in the comparison." .

claim:PETASE_P014 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P014: FAST PETase -- is variant of -- IsPETase" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:IsPETase ;
    ahoj:claimPredicate pred:is_variant_of ;
    ahoj:claimSubject ent:FAST_PETase ;
    ahoj:claimText "FAST-PETase is an engineered IsPETase variant tested in the standardized workflow." .

claim:PETASE_P015 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P015: HOT PETase -- is variant of -- IsPETase" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:IsPETase ;
    ahoj:claimPredicate pred:is_variant_of ;
    ahoj:claimSubject ent:HOT_PETase ;
    ahoj:claimText "HOT-PETase is an engineered IsPETase variant tested in the standardized workflow." .

claim:PETASE_P016 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P016: E coli expression strains -- do not show significant difference in -- FAST PETase solubility" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:FAST_PETase_solubility ;
    ahoj:claimPredicate pred:do_not_show_significant_difference_in ;
    ahoj:claimSubject ent:E_coli_expression_strains ;
    ahoj:claimText "Six E. coli strains did not show significant differences in FAST-PETase yield or solubility under the initial tested conditions." .

claim:PETASE_P017 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P017: BL21 CodonPlus DE3 RIL -- was selected for -- Large scale PETase production" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Large_scale_PETase_production ;
    ahoj:claimPredicate pred:was_selected_for ;
    ahoj:claimSubject ent:BL21_CodonPlus_DE3_RIL ;
    ahoj:claimText "BL21-CodonPlus(DE3)-RIL was selected for the final large-scale expression protocol." .

claim:PETASE_P018 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P018: Expression temperature -- has greater impact on -- Soluble protein yield" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Soluble_protein_yield ;
    ahoj:claimPredicate pred:has_greater_impact_on ;
    ahoj:claimSubject ent:Expression_temperature ;
    ahoj:claimText "Expression temperature strongly affects soluble PETase production and has greater impact than strain selection." .

claim:PETASE_P019 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P019: Expression at 37 C -- leads to -- Protein accumulation in pellet fraction" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Protein_accumulation_in_pellet_fraction ;
    ahoj:claimPredicate pred:leads_to ;
    ahoj:claimSubject ent:Expression_at_37_C ;
    ahoj:claimText "At 37 degrees Celsius, the target protein is predominantly found in the pellet fraction." .

claim:PETASE_P020 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P020: Expression at 20 to 25 C -- improves -- Soluble PETase yield" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Soluble_PETase_yield ;
    ahoj:claimPredicate pred:improves ;
    ahoj:claimSubject ent:Expression_at_20_to_25_C ;
    ahoj:claimText "Lower expression temperatures around 20-25 degrees Celsius improve soluble PETase yield." .

claim:PETASE_P021 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P021: PETase -- contains -- Disulfide bond" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Disulfide_bond ;
    ahoj:claimPredicate pred:contains ;
    ahoj:claimSubject ent:PETase ;
    ahoj:claimText "PETase variants contain cysteine residues forming disulfide bonds, which were confirmed by intact mass analysis." .

claim:PETASE_P022 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P022: Signal peptide -- is cleaved during -- PETase expression" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:PETase_expression ;
    ahoj:claimPredicate pred:is_cleaved_during ;
    ahoj:claimSubject ent:Signal_peptide ;
    ahoj:claimText "The 27-residue N-terminal signal peptide is cleaved during expression, yielding protein starting at Gln28." .

claim:PETASE_P023 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P023: Signal peptide presence -- appears inconsequential for -- Downstream PETase activity" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Downstream_PETase_activity ;
    ahoj:claimPredicate pred:appears_inconsequential_for ;
    ahoj:claimSubject ent:Signal_peptide_presence ;
    ahoj:claimText "Because the signal peptide is cleaved, its presence appears inconsequential for downstream enzymatic activity." .

claim:PETASE_P024 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P024: Ni NTA -- produces higher purity than -- HisTrap" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:HisTrap ;
    ahoj:claimPredicate pred:produces_higher_purity_than ;
    ahoj:claimSubject ent:Ni_NTA ;
    ahoj:claimText "Ni-NTA purification produced cleaner PETase eluate than HisTrap under the tested conditions." .

claim:PETASE_P025 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P025: SEC -- is crucial for -- Consistent PETase purity" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Consistent_PETase_purity ;
    ahoj:claimPredicate pred:is_crucial_for ;
    ahoj:claimSubject ent:SEC ;
    ahoj:claimText "Size exclusion chromatography removes residual contaminants and is crucial for consistent protein quality." .

claim:PETASE_P026 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P026: Two step IMAC SEC -- produces higher activity than -- Single step IMAC" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Single_step_IMAC ;
    ahoj:claimPredicate pred:produces_higher_activity_than ;
    ahoj:claimSubject ent:Two_step_IMAC_SEC ;
    ahoj:claimText "Two-step IMAC plus SEC purification yields higher PET hydrolysis activity than single-step IMAC purification." .

claim:PETASE_P027 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P027: Ni NTA SEC protocol -- is standardized protocol for -- PETase activity assessment" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:PETase_activity_assessment ;
    ahoj:claimPredicate pred:is_standardized_protocol_for ;
    ahoj:claimSubject ent:Ni_NTA_SEC_protocol ;
    ahoj:claimText "Ni-NTA followed by SEC is validated as a standardized protocol for assessing PETase variants." .

claim:PETASE_P028 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P028: Residual imidazole -- does not impair -- PETase catalytic function" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:PETase_catalytic_function ;
    ahoj:claimPredicate pred:does_not_impair ;
    ahoj:claimSubject ent:Residual_imidazole ;
    ahoj:claimText "Dialyzed and non-dialyzed samples showed no measurable difference in activity, suggesting imidazole does not impair catalysis." .

claim:PETASE_P029 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P029: Spectrophotometric A240 assay -- measures -- Soluble aromatic product release" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Soluble_aromatic_product_release ;
    ahoj:claimPredicate pred:measures ;
    ahoj:claimSubject ent:Spectrophotometric_A240_assay ;
    ahoj:claimText "The assay monitors absorbance at 240 nm as a proxy for soluble aromatic hydrolysis products including BHET, MHET, and TPA." .

claim:PETASE_P030 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P030: Standardized assay setup -- uses -- Semi crystalline PET powder" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Semi_crystalline_PET_powder ;
    ahoj:claimPredicate pred:uses ;
    ahoj:claimSubject ent:Standardized_assay_setup ;
    ahoj:claimText "The standardized activity assay uses semi-crystalline PET powder as the real PET substrate." .

claim:PETASE_P031 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P031: IsPETase WT -- has moderate activity at -- 30 C" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:30_C ;
    ahoj:claimPredicate pred:has_moderate_activity_at ;
    ahoj:claimSubject ent:IsPETase_WT ;
    ahoj:claimText "Wild-type IsPETase displays moderate activity at 30 degrees Celsius and declines at higher temperature." .

claim:PETASE_P032 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P032: PETase W185A -- has low -- PET hydrolysis activity" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:PET_hydrolysis_activity ;
    ahoj:claimPredicate pred:has_low ;
    ahoj:claimSubject ent:PETase_W185A ;
    ahoj:claimText "PETase W185A shows low activity across tested temperatures." .

claim:PETASE_P033 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P033: PETase W159H S238F -- has increased activity at -- 40 C" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:40_C ;
    ahoj:claimPredicate pred:has_increased_activity_at ;
    ahoj:claimSubject ent:PETase_W159H_S238F ;
    ahoj:claimText "PETase W159H/S238F has increased activity at 40 degrees Celsius but undetectable activity at 50 degrees Celsius." .

claim:PETASE_P034 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P034: FAST PETase -- has optimal hydrolysis at -- 40 C" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:40_C ;
    ahoj:claimPredicate pred:has_optimal_hydrolysis_at ;
    ahoj:claimSubject ent:FAST_PETase ;
    ahoj:claimText "FAST-PETase remains active across tested temperatures and shows optimal hydrolysis around 40 degrees Celsius." .

claim:PETASE_P035 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P035: HOT PETase -- has highest activity at -- 50 C" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:50_C ;
    ahoj:claimPredicate pred:has_highest_activity_at ;
    ahoj:claimSubject ent:HOT_PETase ;
    ahoj:claimText "HOT-PETase exhibits the highest activity at 50 degrees Celsius and maintains a steady hydrolysis rate over 48 hours." .

claim:PETASE_P036 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P036: PETase variant activity -- correlates with -- Melting temperature" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Melting_temperature ;
    ahoj:claimPredicate pred:correlates_with ;
    ahoj:claimSubject ent:PETase_variant_activity ;
    ahoj:claimText "The activity profiles of variants correlate with their melting temperatures." .

claim:PETASE_P037 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P037: FAST PETase and HOT PETase -- outperform -- Wild type IsPETase at elevated temperatures" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Wild_type_IsPETase_at_elevated_temperatures ;
    ahoj:claimPredicate pred:outperform ;
    ahoj:claimSubject ent:FAST_PETase_and_HOT_PETase ;
    ahoj:claimText "FAST-PETase and HOT-PETase show enhanced hydrolysis at higher temperatures compared with wild-type IsPETase." .

claim:PETASE_P038 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P038: Assay setup variability -- affects -- Observed PETase activity" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Observed_PETase_activity ;
    ahoj:claimPredicate pred:affects ;
    ahoj:claimSubject ent:Assay_setup_variability ;
    ahoj:claimText "Substrate type, enzyme-to-substrate ratio, buffer, pH, temperature, and measurement interval can affect observed PETase activity." .

claim:PETASE_P039 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P039: Different product quantification methods -- introduce -- PETase activity comparison variability" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:PETase_activity_comparison_variability ;
    ahoj:claimPredicate pred:introduce ;
    ahoj:claimSubject ent:Different_product_quantification_methods ;
    ahoj:claimText "Different methods for quantifying TPA, MHET, and BHET introduce additional variability into cross-study PETase comparisons." .

claim:PETASE_P040 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P040: Expression and purification variability -- is overlooked contributor to -- PETase performance inconsistency" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:PETase_performance_inconsistency ;
    ahoj:claimPredicate pred:is_overlooked_contributor_to ;
    ahoj:claimSubject ent:Expression_and_purification_variability ;
    ahoj:claimText "Expression and purification variability may be an overlooked contributor to inconsistent PETase performance data." .

claim:PETASE_P041 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P041: PETase standardized workflow -- reduces -- Inter study variability" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Inter_study_variability ;
    ahoj:claimPredicate pred:reduces ;
    ahoj:claimSubject ent:PETase_standardized_workflow ;
    ahoj:claimText "The workflow is intended to reduce inter-study variability in PETase production and assessment." .

claim:PETASE_P042 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P042: PETase standardized workflow -- supports -- Biocatalyst development" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Biocatalyst_development ;
    ahoj:claimPredicate pred:supports ;
    ahoj:claimSubject ent:PETase_standardized_workflow ;
    ahoj:claimText "The standardized workflow supports development of efficient biocatalysts for plastic waste biodegradation and upcycling." .

claim:PETASE_P043 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P043: PETase standardized workflow -- is complementary to -- AHoJ DB" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:AHoJ_DB ;
    ahoj:claimPredicate pred:is_complementary_to ;
    ahoj:claimSubject ent:PETase_standardized_workflow ;
    ahoj:claimText "The PETase workflow standardizes experimental enzyme production and activity comparison, while AHoJ-DB standardizes structural apo/holo pocket comparison." .

claim:PETASE_P044 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P044: PETase variant -- has -- Protein structure" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Protein_structure ;
    ahoj:claimPredicate pred:has ;
    ahoj:claimSubject ent:PETase_variant ;
    ahoj:claimText "PETase variants can be connected to protein structures in a knowledge graph." .

claim:PETASE_P045 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P045: PETase active site -- is a -- Binding pocket" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Binding_pocket ;
    ahoj:claimPredicate pred:is_a ;
    ahoj:claimSubject ent:PETase_active_site ;
    ahoj:claimText "A PETase active site can be modeled as a protein binding pocket, enabling reuse of AHoJ-DB-style pocket concepts." .

claim:PETASE_P046 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P046: PETase activity comparison -- can be enriched by -- Binding pocket geometry" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Binding_pocket_geometry ;
    ahoj:claimPredicate pred:can_be_enriched_by ;
    ahoj:claimSubject ent:PETase_activity_comparison ;
    ahoj:claimText "PETase activity comparisons could be enriched by structural descriptors of active-site or substrate-binding pocket geometry." .

claim:PETASE_P047 a ahoj:ClaimTriplet ;
    rdfs:label "PETASE_P047: PETase research -- benefits from -- Reproducibility" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:claimObject ent:Reproducibility ;
    ahoj:claimPredicate pred:benefits_from ;
