    ahoj:unit "degree Celsius" .

ent:N_terminal_signal_peptide_length a ahoj:Statistic ;
    rdfs:label "N terminal signal peptide length" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:reportedValue 27 ;
    ahoj:unit "amino acids" .

ent:PET_powder_mass_in_assay a ahoj:Statistic ;
    rdfs:label "PET powder mass in assay" ;
    prov:wasDerivedFrom ent:Article_PETase_Workflow_2025 ;
    ahoj:reportedValue 5 ;
