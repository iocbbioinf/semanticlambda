    rdfs:label "claim predicate" .

ahoj:claimSubject a rdf:Property ;
    rdfs:label "claim subject" .

ahoj:claimText a rdf:Property ;
    rdfs:label "claim text" .

ahoj:externalAlignment a rdf:Property ;
    rdfs:label "external alignment" .

ahoj:hasClaim a rdf:Property ;
    rdfs:label "has claim" .

ahoj:mappedBy a rdf:Property ;
    rdfs:label "mapped by" .

ahoj:mappingObject a rdf:Property ;
    rdfs:label "mapping object" .

ahoj:mappingPredicate a rdf:Property ;
    rdfs:label "mapping predicate" .

ahoj:mappingSubject a rdf:Property ;
    rdfs:label "mapping subject" .

ahoj:reportedValue a rdf:Property ;
    rdfs:label "reported value" .

ahoj:sourcePaper a rdf:Property ;
    rdfs:label "source paper" .

ahoj:supportsUseCase a rdf:Property ;
    rdfs:label "supports use case" .

ahoj:unit a rdf:Property ;
    rdfs:label "unit" .

ahoj:usesResource a rdf:Property ;
    rdfs:label "uses resource" .

chembl: rdfs:label "ChEMBL" .

chebi:18405 rdfs:label "pyridoxal 5'-phosphate" .

claim:C001 a ahoj:ClaimTriplet ;
    rdfs:label "C001: Protein_structure - rarely captures - Protein_conformational_variability" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Protein_conformational_variability ;
    ahoj:claimPredicate pred:rarely_captures ;
    ahoj:claimSubject ent:Protein_structure ;
    ahoj:claimText "A single experimentally determined protein structure is usually insufficient to describe the conformational variability of a protein. Both apo and holo structures are needed to understand protein geometry and make meaningful comparisons." .

claim:C002 a ahoj:ClaimTriplet ;
    rdfs:label "C002: Apo_structure_and_holo_structure - are essential for - Protein_conformational_variability" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Protein_conformational_variability ;
    ahoj:claimPredicate pred:are_essential_for ;
    ahoj:claimSubject ent:Apo_structure_and_holo_structure ;
    ahoj:claimText "Apo and holo forms provide complementary views of the same protein. Comparing them helps expose structural changes associated with ligand binding." .

claim:C003 a ahoj:ClaimTriplet ;
    rdfs:label "C003: Drug_design_and_docking - often rely on - Protein_structure" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Protein_structure ;
    ahoj:claimPredicate pred:often_rely_on ;
    ahoj:claimSubject ent:Drug_design_and_docking ;
    ahoj:claimText "The paper argues that docking and drug-design studies often still use mostly rigid holo structures. This can miss conformational diversity relevant to binding and prediction." .

claim:C004 a ahoj:ClaimTriplet ;
    rdfs:label "C004: Machine_learning_tool_development - often use - Protein_structure" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Protein_structure ;
    ahoj:claimPredicate pred:often_use ;
    ahoj:claimSubject ent:Machine_learning_tool_development ;
    ahoj:claimText "Training and testing of ligand-binding-site predictors is often performed on one holo structure as a representative. The paper presents this as unrealistic because the apo form may differ from the holo binding-site geometry." .

claim:C005 a ahoj:ClaimTriplet ;
    rdfs:label "C005: Existing_apo_holo_resource - are needed for - Structural_biology_use_case" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Structural_biology_use_case ;
    ahoj:claimPredicate pred:are_needed_for ;
    ahoj:claimSubject ent:Existing_apo_holo_resource ;
    ahoj:claimText "The paper states that curated apo-holo datasets are needed for machine-learning development, benchmarking, and structural analysis. Dataset size and availability are presented as limiting factors for progress." .

claim:C006 a ahoj:ClaimTriplet ;
    rdfs:label "C006: Apo_holo_classification - can be ambiguous for - Protein" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Protein ;
    ahoj:claimPredicate pred:can_be_ambiguous_for ;
    ahoj:claimSubject ent:Apo_holo_classification ;
    ahoj:claimText "Assigning apo or holo status to an entire chain can be misleading when the same chain contains multiple pockets. One site may be ligand-bound while another site is not." .

claim:C007 a ahoj:ClaimTriplet ;
    rdfs:label "C007: Apo_holo_classification - can be ambiguous for - Multi_pocket_structure" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Multi_pocket_structure ;
    ahoj:claimPredicate pred:can_be_ambiguous_for ;
    ahoj:claimSubject ent:Apo_holo_classification ;
    ahoj:claimText "Classifying a whole structure as apo or holo can obscure the state of individual binding pockets. The paper therefore argues for pocket-level classification." .

claim:C008 a ahoj:ClaimTriplet ;
    rdfs:label "C008: Binding_pocket - provides reference point for - Apo_holo_classification" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Apo_holo_classification ;
    ahoj:claimPredicate pred:provides_reference_point_for ;
    ahoj:claimSubject ent:Binding_pocket ;
    ahoj:claimText "AHoJ-DB treats the binding pocket, not the full protein structure, as the reference point for apo/holo assignment. This makes classification more precise for proteins with multiple binding sites." .

claim:C009 a ahoj:ClaimTriplet ;
    rdfs:label "C009: Pocket_centric_view - clarifies - Apo_holo_classification" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Apo_holo_classification ;
    ahoj:claimPredicate pred:clarifies ;
    ahoj:claimSubject ent:Pocket_centric_view ;
    ahoj:claimText "The paper claims that a pocket-centric view is practical for clarifying whether a corresponding site is apo or holo. This is one of the conceptual foundations of AHoJ-DB." .

claim:C010 a ahoj:ClaimTriplet ;
    rdfs:label "C010: AHoJ_DB - uses input interactions from - BioLiP2" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:BioLiP2 ;
    ahoj:claimPredicate pred:uses_input_interactions_from ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "AHoJ-DB starts from biologically relevant protein-ligand interactions taken from the redundant set of BioLiP2. These interactions define the initial holo query sites." .

claim:C011 a ahoj:ClaimTriplet ;
    rdfs:label "C011: AHoJ_DB_input_selection - excludes - Excluded_interaction_type" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Excluded_interaction_type ;
    ahoj:claimPredicate pred:excludes ;
    ahoj:claimSubject ent:AHoJ_DB_input_selection ;
    ahoj:claimText "The authors excluded interactions between proteins and peptides from the input set. The database focuses on non-peptide, non-nucleic-acid ligand interactions." .

claim:C012 a ahoj:ClaimTriplet ;
    rdfs:label "C012: AHoJ_DB_input_selection - excludes - Excluded_interaction_type" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Excluded_interaction_type ;
    ahoj:claimPredicate pred:excludes ;
    ahoj:claimSubject ent:AHoJ_DB_input_selection ;
    ahoj:claimText "Protein-nucleic-acid interactions were discarded from the initial query set. This keeps the database focused on protein-small-molecule ligand binding." .

claim:C013 a ahoj:ClaimTriplet ;
    rdfs:label "C013: AHoJ_DB_input_selection - requires - UniProt_accession" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:UniProt_accession ;
    ahoj:claimPredicate pred:requires ;
    ahoj:claimSubject ent:AHoJ_DB_input_selection ;
    ahoj:claimText "Interactions without UniProt accession assignment were excluded because the method searches for candidate structures within the same UniProt accession. UniProt is therefore essential for grouping comparable structures." .

claim:C014 a ahoj:ClaimTriplet ;
    rdfs:label "C014: AHoJ_DB - uses structures from - PDB" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:PDB ;
    ahoj:claimPredicate pred:uses_structures_from ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "The PDB provides the experimental protein structures searched by AHoJ-DB. Candidate apo and holo pockets are identified across PDB structures assigned to the same UniProt accession." .

claim:C015 a ahoj:ClaimTriplet ;
    rdfs:label "C015: AHoJ_DB - uses residue mappings from - SIFTS" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:SIFTS ;
    ahoj:claimPredicate pred:uses_residue_mappings_from ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "SIFTS is used to map query pocket residues across other PDB structures of the same UniProt protein. This enables comparison of corresponding sequence positions across different structures." .

claim:C016 a ahoj:ClaimTriplet ;
    rdfs:label "C016: Query_ligand - defines - Query_pocket" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Query_pocket ;
    ahoj:claimPredicate pred:defines ;
    ahoj:claimSubject ent:Query_ligand ;
    ahoj:claimText "The query ligand defines the binding pocket by proximity. Residues near the ligand become the binding residues of the query pocket." .

claim:C017 a ahoj:ClaimTriplet ;
    rdfs:label "C017: Query_pocket - uses distance cutoff - Distance_cutoff_4_5_angstrom" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Distance_cutoff_4_5_angstrom ;
    ahoj:claimPredicate pred:uses_distance_cutoff ;
    ahoj:claimSubject ent:Query_pocket ;
    ahoj:claimText "AHoJ-DB defines binding residues using a 4.5 Å distance cutoff around the query ligand. The same cutoff is later used to detect ligands near mapped candidate pockets." .

claim:C018 a ahoj:ClaimTriplet ;
    rdfs:label "C018: Query_pocket - are mapped through - SIFTS" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:SIFTS ;
    ahoj:claimPredicate pred:are_mapped_through ;
    ahoj:claimSubject ent:Query_pocket ;
    ahoj:claimText "The residues of the query pocket are mapped through SIFTS to corresponding residues in candidate PDB structures. This mapping creates candidate pockets representing the same sequence region." .

claim:C019 a ahoj:ClaimTriplet ;
    rdfs:label "C019: Candidate_structures - are restricted to - UniProt_accession" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:UniProt_accession ;
    ahoj:claimPredicate pred:are_restricted_to ;
    ahoj:claimSubject ent:Candidate_structures ;
    ahoj:claimText "AHoJ-DB searches for candidate pockets only in structures assigned to the same UniProt accession as the query protein. This constrains comparisons to structures of the same protein sequence context." .

claim:C020 a ahoj:ClaimTriplet ;
    rdfs:label "C020: Mapped_candidate_pocket - corresponds to - Query_pocket" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Query_pocket ;
    ahoj:claimPredicate pred:corresponds_to ;
    ahoj:claimSubject ent:Mapped_candidate_pocket ;
    ahoj:claimText "A mapped candidate pocket is the equivalent pocket region in another PDB structure. It corresponds to the query pocket by residue mapping, not necessarily by identical 3D geometry." .

claim:C021 a ahoj:ClaimTriplet ;
    rdfs:label "C021: Mapped_candidate_pocket - may differ geometrically from - Query_pocket" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Query_pocket ;
    ahoj:claimPredicate pred:may_differ_geometrically_from ;
    ahoj:claimSubject ent:Mapped_candidate_pocket ;
    ahoj:claimText "Although mapped candidate pockets correspond to the same sequence region, their local geometry can differ. AHoJ-DB records metrics such as RMSD, volume, SASA, and b-factor to capture these differences." .

claim:C022 a ahoj:ClaimTriplet ;
    rdfs:label "C022: Mapped_candidate_pocket - is classified by - Detected_ligand_near_pocket" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Detected_ligand_near_pocket ;
    ahoj:claimPredicate pred:is_classified_by ;
    ahoj:claimSubject ent:Mapped_candidate_pocket ;
    ahoj:claimText "Candidate pockets are classified as apo or holo depending on whether a ligand is detected near the mapped pocket. The classification is local to the pocket." .

claim:C023 a ahoj:ClaimTriplet ;
    rdfs:label "C023: Holo_pocket - has - Detected_ligand_near_pocket" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Detected_ligand_near_pocket ;
    ahoj:claimPredicate pred:has ;
    ahoj:claimSubject ent:Holo_pocket ;
    ahoj:claimText "A mapped candidate pocket is classified as holo if at least one non-solvent ligand is detected within the cutoff distance. The detected ligand does not have to be the same as the query ligand." .

claim:C024 a ahoj:ClaimTriplet ;
    rdfs:label "C024: Apo_pocket - lacks - Detected_ligand_near_pocket" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Detected_ligand_near_pocket ;
    ahoj:claimPredicate pred:lacks ;
    ahoj:claimSubject ent:Apo_pocket ;
    ahoj:claimText "A mapped candidate pocket is classified as apo when no non-solvent ligand is detected near the mapped pocket. This does not mean the entire structure is ligand-free." .

claim:C025 a ahoj:ClaimTriplet ;
    rdfs:label "C025: Solvent_or_non_solvent_ligand - are excluded from - Apo_holo_classification" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Apo_holo_classification ;
    ahoj:claimPredicate pred:are_excluded_from ;
    ahoj:claimSubject ent:Solvent_or_non_solvent_ligand ;
    ahoj:claimText "The apo/holo classification ignores solvent molecules. Only non-solvent ligands near the mapped pocket determine holo status." .

claim:C026 a ahoj:ClaimTriplet ;
    rdfs:label "C026: Detected_ligand_near_pocket - can justify - Holo_pocket" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Holo_pocket ;
    ahoj:claimPredicate pred:can_justify ;
    ahoj:claimSubject ent:Detected_ligand_near_pocket ;
    ahoj:claimText "The paper treats any detected ligand near the mapped pocket as valid for holo classification, even if the ligand may be crystallographic or not biologically relevant. The rationale is that such ligands can still affect local pocket geometry." .

claim:C027 a ahoj:ClaimTriplet ;
    rdfs:label "C027: AHoJ_DB_input_selection - requires maximum resolution - Resolution_threshold" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Resolution_threshold ;
    ahoj:claimPredicate pred:requires_maximum_resolution ;
    ahoj:claimSubject ent:AHoJ_DB_input_selection ;
    ahoj:claimText "Candidate structures were processed only if they satisfied a broad resolution cutoff of 7 Å. The authors used this permissive threshold to allow broad search coverage." .

claim:C028 a ahoj:ClaimTriplet ;
    rdfs:label "C028: AHoJ_DB_input_selection - requires minimum mapped binding residues on SEQRES - Mapped_residue_coverage_threshold" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Mapped_residue_coverage_threshold ;
    ahoj:claimPredicate pred:requires_minimum_mapped_binding_residues_on_SEQRES ;
    ahoj:claimSubject ent:AHoJ_DB_input_selection ;
    ahoj:claimText "Candidate structures were processed only if at least 30% of the query pocket residues could be mapped onto the candidate SEQRES. Otherwise, the structure was not processed." .

claim:C029 a ahoj:ClaimTriplet ;
    rdfs:label "C029: Candidate_structures - use maximum resolution - Distance_cutoff_4_5_angstrom" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Distance_cutoff_4_5_angstrom ;
    ahoj:claimPredicate pred:use_maximum_resolution ;
    ahoj:claimSubject ent:Candidate_structures ;
    ahoj:claimText "For filtered results displayed in AHoJ-DB, the authors used a softer post-processing filter with a 4.5 Å resolution threshold. These filtered results are separate from the broader processed results." .

claim:C030 a ahoj:ClaimTriplet ;
    rdfs:label "C030: Candidate_structures - are sorted by - Mapped_binding_residue_metric" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Mapped_binding_residue_metric ;
    ahoj:claimPredicate pred:are_sorted_by ;
    ahoj:claimSubject ent:Candidate_structures ;
    ahoj:claimText "Filtered candidate results are primarily sorted by the percentage of mapped binding residues. This favors candidates where the original pocket is more completely represented." .

claim:C031 a ahoj:ClaimTriplet ;
    rdfs:label "C031: Candidate_structures - are also sorted by - Mapped_binding_residue_metric" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Mapped_binding_residue_metric ;
    ahoj:claimPredicate pred:are_also_sorted_by ;
    ahoj:claimSubject ent:Candidate_structures ;
    ahoj:claimText "After mapped-residue coverage, filtered results are sorted by number of observed residues and then by resolution. This prioritizes structurally complete and higher-quality candidate pockets." .

claim:C032 a ahoj:ClaimTriplet ;
    rdfs:label "C032: AHoJ_DB - reports - Structure_metrics" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Structure_metrics ;
    ahoj:claimPredicate pred:reports ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "AHoJ-DB reports metrics describing the whole candidate structure, including resolution and experimental method. These provide context for interpreting pocket-level comparisons." .

claim:C033 a ahoj:ClaimTriplet ;
    rdfs:label "C033: AHoJ_DB - reports - Structure_metrics" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Structure_metrics ;
    ahoj:claimPredicate pred:reports ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "AHoJ-DB reports metrics for protein chains involved in the mapped pocket, including TM-score, chain RMSD, and allosteric factors. These connect pocket changes to broader chain-level structure." .

claim:C034 a ahoj:ClaimTriplet ;
    rdfs:label "C034: AHoJ_DB - reports - Structure_metrics" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Structure_metrics ;
    ahoj:claimPredicate pred:reports ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "AHoJ-DB reports pocket-level metrics including mapped residues, observed residues, SASA, molecular surface, volume, b-factor, radius of gyration, and pocket RMSD. These describe local geometry and completeness of the mapped pocket." .

claim:C035 a ahoj:ClaimTriplet ;
    rdfs:label "C035: Structural_factor - occur within - Relevant_chain" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Relevant_chain ;
    ahoj:claimPredicate pred:occur_within ;
    ahoj:claimSubject ent:Structural_factor ;
    ahoj:claimText "The paper describes allosteric factors as PTMs or ligands occurring within relevant chains but outside the mapped pocket itself. These may help explain structural differences between states." .

claim:C036 a ahoj:ClaimTriplet ;
    rdfs:label "C036: Structural_factor - occur within - Mapped_candidate_pocket" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Mapped_candidate_pocket ;
    ahoj:claimPredicate pred:occur_within ;
    ahoj:claimSubject ent:Structural_factor ;
    ahoj:claimText "Orthosteric factors are ligands, solvent molecules, or PTMs found within the mapped pocket residues. They directly affect interpretation of the local binding site." .

claim:C037 a ahoj:ClaimTriplet ;
    rdfs:label "C037: AHoJ_DB - processed - Protein_ligand_interaction" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Protein_ligand_interaction ;
    ahoj:claimPredicate pred:processed ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "The paper reports that AHoJ-DB processed 468,293 biologically relevant protein-ligand interactions. Each processed interaction corresponds to a separate entry and query binding site." .

claim:C038 a ahoj:ClaimTriplet ;
    rdfs:label "C038: AHoJ_DB - covers - Protein" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Protein ;
    ahoj:claimPredicate pred:covers ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "The processed interactions span 27,983 proteins. Protein identity is organized through UniProt accession assignments." .

claim:C039 a ahoj:ClaimTriplet ;
    rdfs:label "C039: AHoJ_DB - has apo form for - Apo_coverage_statistic" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Apo_coverage_statistic ;
    ahoj:claimPredicate pred:has_apo_form_for ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "In the unfiltered database, 230,269 of 468,293 entries have at least one apo form. This corresponds to 49.2% of processed entries." .

claim:C040 a ahoj:ClaimTriplet ;
    rdfs:label "C040: AHoJ_DB - has apo form for - UniProt_accession" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:UniProt_accession ;
    ahoj:claimPredicate pred:has_apo_form_for ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "At the UniProt level, 13,068 of 27,983 accessions have at least one apo candidate in the unfiltered database. This corresponds to 46.7% of represented UniProt accessions." .

claim:C041 a ahoj:ClaimTriplet ;
    rdfs:label "C041: Processed_binding_sites - often lack - Apo_pocket" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Apo_pocket ;
    ahoj:claimPredicate pred:often_lack ;
    ahoj:claimSubject ent:Processed_binding_sites ;
    ahoj:claimText "The paper concludes that less than half of the processed binding sites have an apo form in the PDB. This lack of apo structures may limit benchmark construction and model evaluation." .

claim:C042 a ahoj:ClaimTriplet ;
    rdfs:label "C042: Filtered_subset - applies - Resolution_threshold" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Resolution_threshold ;
    ahoj:claimPredicate pred:applies ;
    ahoj:claimSubject ent:Filtered_subset ;
    ahoj:claimText "Subset 1 includes structures with resolution 4.5 Å or better and only diffraction methods. It also requires 100% mapped binding residues on SEQRES but allows some mapped residues to be unobserved." .

claim:C043 a ahoj:ClaimTriplet ;
    rdfs:label "C043: Filtered_subset - yielded - Dataset_size_statistic" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Dataset_size_statistic ;
    ahoj:claimPredicate pred:yielded ;
    ahoj:claimSubject ent:Filtered_subset ;
    ahoj:claimText "Subset 1 yielded 451,408 entries across 27,162 UniProt accessions. Among these, 41% had at least one apo state." .

claim:C044 a ahoj:ClaimTriplet ;
    rdfs:label "C044: Apo_pocket_in_filtered_subset - have more - Mapped_binding_residue_metric" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Mapped_binding_residue_metric ;
    ahoj:claimPredicate pred:have_more ;
    ahoj:claimSubject ent:Apo_pocket_in_filtered_subset ;
    ahoj:claimText "In Subset 1, apo pockets showed a much higher percentage of unobserved mapped binding residues than holo pockets. The paper interprets this as evidence that apo pockets are less likely to have ordered structural representation." .

claim:C045 a ahoj:ClaimTriplet ;
    rdfs:label "C045: Filtered_subset - requires - Mapped_binding_residue_metric" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Mapped_binding_residue_metric ;
    ahoj:claimPredicate pred:requires ;
    ahoj:claimSubject ent:Filtered_subset ;
    ahoj:claimText "Subset 2 applies the same resolution and diffraction-method filters as Subset 1 but also requires all mapped binding residues to be observed. This enables more confident pocket-level geometric comparisons." .

claim:C046 a ahoj:ClaimTriplet ;
    rdfs:label "C046: Filtered_subset - has apo result for - Apo_coverage_statistic" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Apo_coverage_statistic ;
    ahoj:claimPredicate pred:has_apo_result_for ;
    ahoj:claimSubject ent:Filtered_subset ;
    ahoj:claimText "In Subset 2, 175,388 entries had at least one apo result. This corresponds to 39% of entries under those filtering criteria." .

claim:C047 a ahoj:ClaimTriplet ;
    rdfs:label "C047: Apo_pocket_in_filtered_subset - have higher - Pocket_geometry_metric" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Pocket_geometry_metric ;
    ahoj:claimPredicate pred:have_higher ;
    ahoj:claimSubject ent:Apo_pocket_in_filtered_subset ;
    ahoj:claimText "Subset 2 shows that apo pockets have consistently higher RMSD relative to the query pocket than holo pockets. The paper suggests this may point toward cryptic-site-like behavior." .

claim:C048 a ahoj:ClaimTriplet ;
    rdfs:label "C048: Apo_pocket_in_filtered_subset - have higher - Pocket_geometry_metric" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Pocket_geometry_metric ;
    ahoj:claimPredicate pred:have_higher ;
    ahoj:claimSubject ent:Apo_pocket_in_filtered_subset ;
    ahoj:claimText "The higher RMSD trend also extends to the chain level. Apo relevant chains show higher chain RMSD than holo relevant chains." .

claim:C049 a ahoj:ClaimTriplet ;
    rdfs:label "C049: Apo_pocket_in_filtered_subset - have smaller - Pocket_geometry_metric" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Pocket_geometry_metric ;
    ahoj:claimPredicate pred:have_smaller ;
    ahoj:claimSubject ent:Apo_pocket_in_filtered_subset ;
    ahoj:claimText "The paper reports that apo pockets appear smaller overall than holo pockets in Subset 2. This supports the idea that ligand binding may open or stabilize pocket geometry." .

claim:C050 a ahoj:ClaimTriplet ;
    rdfs:label "C050: Apo_pocket - have higher - Pocket_geometry_metric" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Pocket_geometry_metric ;
    ahoj:claimPredicate pred:have_higher ;
    ahoj:claimSubject ent:Apo_pocket ;
    ahoj:claimText "Apo pockets show higher per-atom b-factor values than holo pockets. The paper interprets this as supporting the idea that apo pockets are less ordered overall." .

claim:C051 a ahoj:ClaimTriplet ;
    rdfs:label "C051: PDB - is biased toward - Holo_pocket" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Holo_pocket ;
    ahoj:claimPredicate pred:is_biased_toward ;
    ahoj:claimSubject ent:PDB ;
    ahoj:claimText "The paper observes consistently higher numbers of pockets, structures, and chains for holo states than apo states. This is interpreted as evidence of an inherent PDB bias toward holo structures." .

claim:C052 a ahoj:ClaimTriplet ;
    rdfs:label "C052: Ligand - influences - Ligand_apo_coverage" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Ligand_apo_coverage ;
    ahoj:claimPredicate pred:influences ;
    ahoj:claimSubject ent:Ligand ;
    ahoj:claimText "When entries are grouped by ligand, the fraction of sites with apo-paired entries varies strongly. This suggests that apo availability is ligand-dependent." .

claim:C053 a ahoj:ClaimTriplet ;
    rdfs:label "C053: Ligand_apo_coverage - have high - Ligand_apo_coverage" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Ligand_apo_coverage ;
    ahoj:claimPredicate pred:have_high ;
    ahoj:claimSubject ent:Ligand_apo_coverage ;
    ahoj:claimText "Glucose-binding entries show high apo-paired coverage compared with many other ligands. The paper reports glucose coverage around 73% by sites in the ligand-group analysis." .

claim:C054 a ahoj:ClaimTriplet ;
    rdfs:label "C054: Ligand_apo_coverage - have low - Ligand_apo_coverage" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Ligand_apo_coverage ;
    ahoj:claimPredicate pred:have_low ;
    ahoj:claimSubject ent:Ligand_apo_coverage ;
    ahoj:claimText "Chlorophyll A binding sites show very low apo-paired coverage. The paper reports about 1% coverage by sites for chlorophyll A in the analyzed subset." .

claim:C055 a ahoj:ClaimTriplet ;
    rdfs:label "C055: Ligand_apo_coverage - have very low - Ligand_apo_coverage" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Ligand_apo_coverage ;
    ahoj:claimPredicate pred:have_very_low ;
    ahoj:claimSubject ent:Ligand_apo_coverage ;
    ahoj:claimText "Fe4S4 iron-sulfur cluster binding sites show almost no apo-paired coverage. The paper suggests such ligand classes may correspond to pockets or structures that are difficult to resolve without the ligand." .

claim:C056 a ahoj:ClaimTriplet ;
    rdfs:label "C056: Ligand - may stabilize - Less_ordered_pocket" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Less_ordered_pocket ;
    ahoj:claimPredicate pred:may_stabilize ;
    ahoj:claimSubject ent:Ligand ;
    ahoj:claimText "The paper suggests that some ligands may bind less ordered pockets or structures that are harder to resolve in the absence of ligand. This is offered as a possible explanation for ligand-specific differences in apo coverage." .

claim:C057 a ahoj:ClaimTriplet ;
    rdfs:label "C057: Binding_pocket - can occur at - Interface_binding_pocket" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Interface_binding_pocket ;
    ahoj:claimPredicate pred:can_occur_at ;
    ahoj:claimSubject ent:Binding_pocket ;
    ahoj:claimText "The paper emphasizes that many protein-ligand binding sites are formed at interfaces between chains. These sites are important but harder to annotate across structures." .

claim:C058 a ahoj:ClaimTriplet ;
    rdfs:label "C058: Interface_binding_pocket - account for - Interface_site_statistic" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Interface_site_statistic ;
    ahoj:claimPredicate pred:account_for ;
    ahoj:claimSubject ent:Interface_binding_pocket ;
    ahoj:claimText "Using the 4.5 Å cutoff, the paper reports that approximately 24% of binding sites involve two or more chains. This makes interface pockets a substantial fraction of binding sites." .

claim:C059 a ahoj:ClaimTriplet ;
    rdfs:label "C059: Interface_binding_pocket - account for - Interface_site_statistic" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Interface_site_statistic ;
    ahoj:claimPredicate pred:account_for ;
    ahoj:claimSubject ent:Interface_binding_pocket ;
    ahoj:claimText "The paper reports that about 9% of binding pockets involve multiple UniProt accessions, corresponding to heteromeric binding sites. These are a subset of multi-chain pockets." .

claim:C060 a ahoj:ClaimTriplet ;
    rdfs:label "C060: Interface_binding_pocket - are often neglected or misrepresented in - Data_processing_workflow" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Data_processing_workflow ;
    ahoj:claimPredicate pred:are_often_neglected_or_misrepresented_in ;
    ahoj:claimSubject ent:Interface_binding_pocket ;
    ahoj:claimText "The paper states that interface pockets are often neglected or misrepresented because of their complexity. AHoJ-DB explicitly supports such pockets." .

claim:C061 a ahoj:ClaimTriplet ;
    rdfs:label "C061: AHoJ_DB - is compatible with - Interface_binding_pocket" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Interface_binding_pocket ;
    ahoj:claimPredicate pred:is_compatible_with ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "AHoJ-DB can handle binding sites formed by multiple chains. This allows the database to represent apo/holo relationships for pockets at protein-protein interfaces." .

claim:C062 a ahoj:ClaimTriplet ;
    rdfs:label "C062: Existing_apo_holo_resource - are often - Manual_dataset_assembly" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Manual_dataset_assembly ;
    ahoj:claimPredicate pred:are_often ;
    ahoj:claimSubject ent:Existing_apo_holo_resource ;
    ahoj:claimText "The paper notes that many existing apo-holo datasets were manually assembled. Manual assembly indirectly limits size and expandability." .

claim:C063 a ahoj:ClaimTriplet ;
    rdfs:label "C063: Manual_dataset_assembly - limits - Manual_dataset_assembly" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Manual_dataset_assembly ;
    ahoj:claimPredicate pred:limits ;
    ahoj:claimSubject ent:Manual_dataset_assembly ;
    ahoj:claimText "Manual curation can produce high-quality datasets but makes comprehensive and easily updatable apo-holo resources difficult. This motivates the large-scale automated approach of AHoJ-DB." .

claim:C064 a ahoj:ClaimTriplet ;
    rdfs:label "C064: Existing_apo_holo_resource - are not - Manual_dataset_assembly" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Manual_dataset_assembly ;
    ahoj:claimPredicate pred:are_not ;
    ahoj:claimSubject ent:Existing_apo_holo_resource ;
    ahoj:claimText "The paper argues that existing apo-holo resources are not exhaustive. Therefore, large annotated datasets remain necessary." .

claim:C065 a ahoj:ClaimTriplet ;
    rdfs:label "C065: AHoJ_DB - is claimed to be - Comprehensive_apo_holo_database_claim" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Comprehensive_apo_holo_database_claim ;
    ahoj:claimPredicate pred:is_claimed_to_be ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "In the conclusion, the authors state that AHoJ-DB is, to their knowledge, the most comprehensive database for apo and holo structures to date. This claim is based on the scale and pocket-centric coverage reported in the paper." .

claim:C066 a ahoj:ClaimTriplet ;
    rdfs:label "C066: AHoJ_DB - can support - Structural_biology_use_case" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Structural_biology_use_case ;
    ahoj:claimPredicate pred:can_support ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "The authors state that AHoJ-DB can support protein structure analysis by providing annotated apo/holo structure ensembles. These ensembles reflect conformational variability present in the PDB." .

claim:C067 a ahoj:ClaimTriplet ;
    rdfs:label "C067: AHoJ_DB - can support - Machine_learning_tool_development" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Machine_learning_tool_development ;
    ahoj:claimPredicate pred:can_support ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "The database can be used to train and evaluate machine-learning tools. The paper specifically connects this to ligand-binding-site prediction and structural comparison." .

claim:C068 a ahoj:ClaimTriplet ;
    rdfs:label "C068: AHoJ_DB - can support - Drug_design_and_docking" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Drug_design_and_docking ;
    ahoj:claimPredicate pred:can_support ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "AHoJ-DB can help drug-design and docking experiments by exposing apo/holo pocket variability. This may reduce reliance on a single rigid holo structure." .

claim:C069 a ahoj:ClaimTriplet ;
    rdfs:label "C069: AHoJ_DB - can support - Machine_learning_tool_development" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Machine_learning_tool_development ;
    ahoj:claimPredicate pred:can_support ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "The database provides pocket-level apo/holo annotations that can be used to train or evaluate ligand-binding-site predictors. This is one of the motivating use cases behind the resource." .

claim:C070 a ahoj:ClaimTriplet ;
    rdfs:label "C070: AHoJ_DB - can support - Binding_site_analysis_use_case" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Binding_site_analysis_use_case ;
    ahoj:claimPredicate pred:can_support ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "Because AHoJ-DB compares apo and holo pocket geometries, it can support analysis of cryptic binding sites. Higher apo pocket RMSD and smaller apo pocket volume may indicate hidden or ligand-induced binding-site behavior." .

claim:C071 a ahoj:ClaimTriplet ;
    rdfs:label "C071: AHoJ_DB - can support - Binding_site_analysis_use_case" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Binding_site_analysis_use_case ;
    ahoj:claimPredicate pred:can_support ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "The database records ligands, PTMs, and other factors that may occur on relevant chains or within pockets. These annotations can support studies of allosteric effects." .

claim:C072 a ahoj:ClaimTriplet ;
    rdfs:label "C072: AHoJ_DB - can support - Binding_site_analysis_use_case" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Binding_site_analysis_use_case ;
    ahoj:claimPredicate pred:can_support ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "The paper states that AHoJ-DB can help investigate order-to-disorder transitions. This is supported by its tracking of observed and unobserved residues in mapped pockets." .

claim:C073 a ahoj:ClaimTriplet ;
    rdfs:label "C073: AHoJ_DB - can support - Binding_site_analysis_use_case" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Binding_site_analysis_use_case ;
    ahoj:claimPredicate pred:can_support ;
    ahoj:claimSubject ent:AHoJ_DB ;
    ahoj:claimText "By collecting conformational variability across structures with identical or corresponding sequences, AHoJ-DB may support studies of folding dynamics. The paper links structural variability to sequence-independent folding behavior." .

claim:C074 a ahoj:ClaimTriplet ;
    rdfs:label "C074: PDB - contains multiple structures for - Same_protein" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Same_protein ;
    ahoj:claimPredicate pred:contains_multiple_structures_for ;
    ahoj:claimSubject ent:PDB ;
    ahoj:claimText "The paper notes that many PDB structures correspond to the same protein. These structures may differ because they were solved under different conditions or with different bound molecules." .

claim:C075 a ahoj:ClaimTriplet ;
    rdfs:label "C075: Same_protein - can adopt - Protein_conformational_variability" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Protein_conformational_variability ;
    ahoj:claimPredicate pred:can_adopt ;
    ahoj:claimSubject ent:Same_protein ;
    ahoj:claimText "Structures of the same protein sequence can show different local geometries. Binding pockets are one important site where such differences appear." .

claim:C076 a ahoj:ClaimTriplet ;
    rdfs:label "C076: Same_protein - can adopt - Protein_conformational_variability" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Protein_conformational_variability ;
    ahoj:claimPredicate pred:can_adopt ;
    ahoj:claimSubject ent:Same_protein ;
    ahoj:claimText "The paper also notes that identical-sequence protein structures may differ globally. AHoJ-DB helps expose agents responsible for such geometric differences." .

claim:C077 a ahoj:ClaimTriplet ;
    rdfs:label "C077: Protein_conformational_variability - is not readily available without - Data_processing_workflow" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Data_processing_workflow ;
    ahoj:claimPredicate pred:is_not_readily_available_without ;
    ahoj:claimSubject ent:Protein_conformational_variability ;
    ahoj:claimText "Although conformational variability exists in the PDB, it is not immediately available to researchers. It must be extracted, filtered, grouped, and analyzed across structures." .

claim:C078 a ahoj:ClaimTriplet ;
    rdfs:label "C078: AHoJ_DB_web_server - provides - AHoJ_DB_web_server" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:AHoJ_DB_web_server ;
    ahoj:claimPredicate pred:provides ;
    ahoj:claimSubject ent:AHoJ_DB_web_server ;
    ahoj:claimText "The web server provides visualization of apo/holo results and structural superpositions. The figure on page 6 shows the interface with search results and detailed visualization." .

claim:C079 a ahoj:ClaimTriplet ;
    rdfs:label "C079: AHoJ_DB_web_server - provides - AHoJ_DB_web_server" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:AHoJ_DB_web_server ;
    ahoj:claimPredicate pred:provides ;
    ahoj:claimSubject ent:AHoJ_DB_web_server ;
    ahoj:claimText "The web server allows users to search the database by PDB code, UniProt accession, or ligand ID. These search modes support different biological questions." .

claim:C080 a ahoj:ClaimTriplet ;
    rdfs:label "C080: PDB_search_use_case - can reveal - PDB_search_use_case" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:PDB_search_use_case ;
    ahoj:claimPredicate pred:can_reveal ;
    ahoj:claimSubject ent:PDB_search_use_case ;
    ahoj:claimText "The paper says searching by PDB code can reveal information about the diversity of known bound ligands and binding modes. This is useful for inspecting structure-specific ligand binding." .

claim:C081 a ahoj:ClaimTriplet ;
    rdfs:label "C081: UniProt_search_use_case - can reveal - UniProt_search_use_case" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:UniProt_search_use_case ;
    ahoj:claimPredicate pred:can_reveal ;
    ahoj:claimSubject ent:UniProt_search_use_case ;
    ahoj:claimText "Searching by UniProt accession provides an overview of known binding sites and biologically relevant ligands for a protein. The paper illustrates this with glycogen phosphorylase." .

claim:C082 a ahoj:ClaimTriplet ;
    rdfs:label "C082: Ligand_search_use_case - can reveal - Ligand_apo_coverage" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:Ligand_apo_coverage ;
    ahoj:claimPredicate pred:can_reveal ;
    ahoj:claimSubject ent:Ligand_search_use_case ;
    ahoj:claimText "Searching by ligand name or ID can show how many binding sites for that ligand have apo counterparts. The paper uses bacteriochlorophyll A as an example of low apo coverage." .

claim:C083 a ahoj:ClaimTriplet ;
    rdfs:label "C083: ent:Glycogen_phosphorylase_Oryctolagus_cuniculus - is concrete example for - ent:UniProt_search_use_case" ;
    prov:wasDerivedFrom ent:Article_AHoJDB_2024 ;
    ahoj:claimObject ent:UniProt_search_use_case ;
    ahoj:claimPredicate pred:is_concrete_example_for ;
    ahoj:claimSubject ent:Glycogen_phosphorylase_Oryctolagus_cuniculus ;
    ahoj:claimText "The AHoJ-DB paper uses glycogen phosphorylase from Oryctolagus cuniculus as a concrete example for search by UniProt accession." ;
    ahoj:sourceText "The search by UniProt AC provides an overview of known binding sites of the protein and a number of biologically relevant ligands found. It can be compared to the information provided by the PDBe-KB; if we look at glycogen phosphorylase from Oryctolagus cuniculus (UniProt AC: P00489 – see Figure 1) we can see 499 unique protein–ligand interactions – these represent 193 unique ligands, while PDBe-KB provides information about 198 known ligands – five of those are not biologically relevant according to BioLiP2 database. The result also shows us that the most common ligand is PLP that is forming 284 unique interactions in 130 structures. There are 16 sites corresponding to PLP-binding sites in APO form – it can be therefore used to study the variability of PLP binding and detect conformational changes between apo and holo structures. The results also show solvent accessible surface area calculated for the binding site (SASA), and the SASA normalized by the number of amino acids in the binding site that allows the analysis of the binding sites. More detailed information and visualizations of apo holo pairs are available through the 'View' or 'Download' buttons." .

