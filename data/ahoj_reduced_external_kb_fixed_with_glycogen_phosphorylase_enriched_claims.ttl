ahoj:ClaimTriplet a rdfs:Class ;
    rdfs:label "Reified claim represented as subject-predicate-object plus a text explanation" .

ahoj:Concept a rdfs:Class ;
    rdfs:label "Scientific concept" .

ahoj:Database a rdfs:Class ;
    rdfs:label "Database or web resource" .

ahoj:ExternalMapping a rdfs:Class ;
    rdfs:label "external mapping" .

ahoj:ExternalResource a rdfs:Class ;
    rdfs:label "External biomedical or structural resource" .

ahoj:MappingSet a rdfs:Class ;
    rdfs:label "mapping set" .

ahoj:MethodStep a rdfs:Class ;
    rdfs:label "Methodological step" .

ahoj:Metric a rdfs:Class ;
    rdfs:label "Structural or dataset metric" .

ahoj:Paper a rdfs:Class ;
    rdfs:label "Scholarly article" .

ahoj:ResearchProblem a rdfs:Class ;
    rdfs:label "Research problem or motivation" .

ahoj:Software a rdfs:Class ;
    rdfs:label "Software application" .

ahoj:Statistic a rdfs:Class ;
    rdfs:label "Reported quantitative statistic" .

ahoj:UseCase a rdfs:Class ;
    rdfs:label "Downstream use case" .

