  <!-- ═══════════════════════════════════════════════════════════════
       NEW CLAIMS (batch 2) — P046 … P090
  ═══════════════════════════════════════════════════════════════ -->

  <!-- AHoJ_tool -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P046">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P046: AHoJ_tool - was_used_to_build - AHoJ_DB</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_tool"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/was_used_to_build"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_DB"/>
    <ahoj:claimText>AHoJ-DB was built using the previously developed AHoJ application, which performs comprehensive PDB-wide searches for apo-holo pairs given a specific protein-ligand interaction.</ahoj:claimText>
    <ahoj:sourceText>Here, we use a previously developed application (AHoJ) to perform a comprehensive search for apo-holo pairs for 468,293 biologically relevant protein-ligand interactions across 27,983 proteins.</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P047">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P047: AHoJ_tool - defines_pocket_by - Distance_cutoff</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_tool"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/defines_pocket_by"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Distance_cutoff"/>
    <ahoj:claimText>The AHoJ tool defines the binding pocket as all residues within 4.5 Å of the query ligand. The same cutoff is used both to identify binding residues in the query and to detect ligands in mapped candidate pockets.</ahoj:claimText>
    <ahoj:sourceText>We then conducted separate searches for each of these interactions, by specifying the ligand in the query structure, detecting its binding residues (i.e., pocket) based on a cut-off distance threshold (4.5 Å), and then mapping these residues — through SIFTS — across other structures (candidates).</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P048">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P048: AHoJ_tool - applies_broad_cutoff_of - Resolution_threshold</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_tool"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/applies_broad_cutoff_of"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Resolution_threshold"/>
    <ahoj:claimText>The AHoJ tool applies a broad resolution cutoff of 7 Å and a minimum 30% MBR mapping on SEQRES during initial candidate screening, allowing post-filtering by users for specific use cases.</ahoj:claimText>
    <ahoj:sourceText>The resolution cut-off threshold imposed on candidate structures was 7 Å, and the minimum percentage of query pocket residues mapped on the SEQRES of the candidate structure was set at 30%; otherwise, these structures were not processed at all.</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P049">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P049: AHoJ_tool - applies_soft_filter_of - Resolution_threshold</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_tool"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/applies_soft_filter_of"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Resolution_threshold"/>
    <ahoj:claimText>After broad processing, a soft 4.5 Å resolution filter is applied, and results are sorted by MBR percentage, number of observed residues, and resolution. Only these filtered results are displayed in AHoJ-DB.</ahoj:claimText>
    <ahoj:sourceText>A soft filtration was applied upon all processed candidates, where the resolution threshold was 4.5 Å, and the results were sorted based on the following criteria: percentage of mapped binding residues (MBR) on the candidate SEQRES, number of observed residues, resolution.</ahoj:sourceText>
  </rdf:Description>

  <!-- Web_server -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P050">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P050: Web_server - provides - Apo_holo_pair</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Web_server"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/provides"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Apo_holo_pair"/>
    <ahoj:claimText>The AHoJ-DB web server provides visualization and search capabilities, and allows users to download results via the graphical interface or CSV download links for batches of entries.</ahoj:claimText>
    <ahoj:sourceText>The web server provides visualization and search capabilities and makes it possible to download the results through the graphical interface, or, provide the download links for a group of entries acquired through the search function in a CSV file.</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P051">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P051: Web_server - can_support - Drug_design</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Web_server"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/can_support"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Drug_design"/>
    <ahoj:claimText>The web server can be searched by PDB code, ligand CCD name, UniProt AC, or combinations thereof, enabling drug designers to retrieve apo-holo pairs for a ligand of interest.</ahoj:claimText>
    <ahoj:sourceText>The entries can be retrieved by searching through AHoJ-DB for a PDB code, ligand Chemical Component Dictionary (CCD) name, UniProt AC, or a combination of these identifiers.</ahoj:sourceText>
  </rdf:Description>

  <!-- Existing_apo_holo_resource -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P052">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P052: Existing_apo_holo_resource - is_limited_by - Machine_learning</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Existing_apo_holo_resource"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/is_limited_by"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Machine_learning"/>
    <ahoj:claimText>Many existing apo-holo datasets are manually assembled, which limits their size and expandability. Major leaps in machine learning have often been bottlenecked by the lack of large curated datasets rather than by algorithmic limitations.</ahoj:claimText>
    <ahoj:sourceText>Many of the existing datasets are manually assembled, a feature which indirectly limits their size and expandability. Current resources on the topic are by no means exhaustive and the need for large annotated datasets remains. Major leaps in machine learning have often been bottlenecked not by algorithmic logic, but by the size and availability of curated datasets.</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P053">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P053: Existing_apo_holo_resource - is_superseded_by - AHoJ_DB</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Existing_apo_holo_resource"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/is_superseded_by"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_DB"/>
    <ahoj:claimText>AHoJ-DB is claimed to be the most comprehensive apo-holo database to date, superseding prior resources such as LigAsite (816 proteins), ComSin (24,910 pairs) and PSCDB (890 pairs) in scale.</ahoj:claimText>
    <ahoj:sourceText>The authors conclude that AHoJ-DB is, to their knowledge, the most comprehensive database for apo and holo structures to date.</ahoj:sourceText>
  </rdf:Description>

  <!-- Distance_cutoff -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P054">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P054: Distance_cutoff - defines_pocket_by - Binding_pocket</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Distance_cutoff"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/defines_pocket_by"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Binding_pocket"/>
    <ahoj:claimText>The 4.5 Å distance cutoff is used consistently both to define binding residues from the query ligand and to detect ligands in candidate mapped pockets, ensuring a coherent pocket-level comparison.</ahoj:claimText>
    <ahoj:sourceText>The mapped residues are grouped into a mapped candidate pocket and used to detect ligands within the same cut-off distance threshold used to determine binding residues for the ligand of the query structure.</ahoj:sourceText>
  </rdf:Description>

  <!-- Resolution_threshold -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P055">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P055: Resolution_threshold - requires - Subset1</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Resolution_threshold"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/requires"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Subset1"/>
    <ahoj:claimText>Subset 1 requires resolution of 4.5 Å or better and diffraction-only experimental methods, with 100% MBR on SEQRES but no threshold on observed residues.</ahoj:claimText>
    <ahoj:sourceText>Subset 1: Resolution 4.5 Å or better, only diffraction methods. MBR (SEQRES) filtering at 100%, no threshold for number of observed residues.</ahoj:sourceText>
  </rdf:Description>

  <!-- SASA -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P056">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P056: SASA - can_cancel_out_in - Apo_holo_pair</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/SASA"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/can_cancel_out_in"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Apo_holo_pair"/>
    <ahoj:claimText>Differences in SASA between apo and holo pockets tend to cancel out when averaged across all entries, making aggregate SASA comparisons less informative than per-entry pairwise comparisons.</ahoj:claimText>
    <ahoj:sourceText>It is worth noting that differences in SASA measurements seem to cancel out (see sasa_min, sasa_max in Table S1), indicating that averaging over all apo and all holo pocket values is not ideal for discerning differences related to volume or geometry through solvent accessibility.</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P057">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P057: SASA - varies_between - Apo_holo_pair</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/SASA"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/varies_between"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Apo_holo_pair"/>
    <ahoj:claimText>The SASA difference between apo and holo pockets is only 4.1% in Subset 1 and 4.37% in Subset 2, far smaller than the volume (24-29%) or RMSD (40%) differences, indicating SASA is a less discriminating metric.</ahoj:claimText>
    <ahoj:sourceText>SASA shows only 4.1% (Subset 1) and 4.37% (Subset 2) difference between apo and holo averages, while volume shows 29.11% and 23.58% respectively.</ahoj:sourceText>
  </rdf:Description>

  <!-- Chain_RMSD -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P058">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P058: Chain_RMSD - extends_trend_to - Apo_form</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Chain_RMSD"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/extends_trend_to"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Apo_form"/>
    <ahoj:claimText>The higher structural deviation of apo pockets extends to chain-level RMSD: apo relevant chains show 30% higher chain RMSD than holo chains (1.14 Å vs 0.84 Å in Subset 1), confirming global structural divergence beyond the pocket.</ahoj:claimText>
    <ahoj:sourceText>While less pronounced, this trend extends to chain RMSD — calculated by aligning the apo and holo relevant chains onto the respective query chains — (30% difference).</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P059">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P059: Chain_RMSD - is_smaller_than_in - Pocket_RMSD</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Chain_RMSD"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/is_smaller_than_in"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Pocket_RMSD"/>
    <ahoj:claimText>The apo-holo difference in chain RMSD (30%) is less pronounced than the difference in pocket RMSD (40%), indicating that conformational changes are more localised and pronounced at the binding pocket level.</ahoj:claimText>
    <ahoj:sourceText>While less pronounced, this trend extends to chain RMSD — (30% difference). A difference of 40% is observed in pocket RMSD, showing that apo pockets have consistently higher RMSD compared to holo when aligned onto the query pocket.</ahoj:sourceText>
  </rdf:Description>

  <!-- Allosteric_factor -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P060">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P060: Allosteric_factor - may_affect - Binding_pocket</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Allosteric_factor"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/may_affect"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Binding_pocket"/>
    <ahoj:claimText>AHoJ-DB records allosteric factors — PTM residues and ligands occurring on relevant chains but outside the pocket — because they may affect local pocket geometry even without direct contact.</ahoj:claimText>
    <ahoj:sourceText>Allosteric factors include PTM residues and ligands in relevant chains, while orthosteric factors include ligands, solvent molecules or PTMs within mapped pocket residues.</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P061">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P061: Allosteric_factor - can_be_used_to_detect - Conformational_variability</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Allosteric_factor"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/can_be_used_to_detect"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Conformational_variability"/>
    <ahoj:claimText>By annotating allosteric factors on relevant chains, AHoJ-DB enables detection of allosteric effects — distant ligands or PTMs that drive conformational variability at the query pocket.</ahoj:claimText>
    <ahoj:sourceText>AHoJ-DB can support detection of allosteric effects, order-to-disorder studies and folding dynamics.</ahoj:sourceText>
  </rdf:Description>

  <!-- MBR_threshold -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P062">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P062: MBR_threshold - requires - Residue_mapping</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/MBR_threshold"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/requires"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Residue_mapping"/>
    <ahoj:claimText>A minimum of 30% of query pocket residues must be successfully mapped onto a candidate structure's SEQRES for that candidate to be processed at all; candidates below this threshold are discarded without further analysis.</ahoj:claimText>
    <ahoj:sourceText>The minimum percentage of query pocket residues mapped on the SEQRES of the candidate structure was set at 30%; otherwise, these structures were not processed at all.</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P063">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P063: MBR_threshold - requires - Subset1</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/MBR_threshold"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/requires"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Subset1"/>
    <ahoj:claimText>Subset 1 requires 100% MBR mapping on SEQRES, meaning all query pocket residues must be present in the candidate sequence, without requiring them to be observed in the electron density.</ahoj:claimText>
    <ahoj:sourceText>Subset 1: MBR (SEQRES) filtering at 100%, no threshold for number of observed residues.</ahoj:sourceText>
  </rdf:Description>

  <!-- Calcium_ligand -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P064">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P064: Calcium_ligand - has_higher_apo_coverage_than - Zinc_ligand</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Calcium_ligand"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/has_higher_apo_coverage_than"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Zinc_ligand"/>
    <ahoj:claimText>Calcium (CA) has 35% UniProt apo coverage vs 22% for zinc (ZN) in Subset 2, showing that metal-ion ligands vary substantially in their availability of apo counterpart structures.</ahoj:claimText>
    <ahoj:sourceText>Table 2 shows CA with 35% UniProt apo coverage (1220 out of 3474), 51% structures coverage, 44% chains and 38% sites, compared to ZN at 22% UniProt, 34% structures, 28% chains and 26% sites.</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P065">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P065: Calcium_ligand - is_most_abundant_in - Subset2</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Calcium_ligand"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/is_most_abundant_in"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Subset2"/>
    <ahoj:claimText>Calcium (CA) is the second most abundant ligand in Subset 2 with 3,474 UniProt ACs and 37,070 total interaction sites, making it a major contributor to the database after zinc.</ahoj:claimText>
    <ahoj:sourceText>Table 2: CA has 3474 UniProt ACs, 11,499 structures, 22,685 chains and 37,070 sites in total entries of Subset 2.</ahoj:sourceText>
  </rdf:Description>

  <!-- Magnesium_ligand -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P066">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P066: Magnesium_ligand - has_higher_apo_coverage_than - Zinc_ligand</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Magnesium_ligand"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/has_higher_apo_coverage_than"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Zinc_ligand"/>
    <ahoj:claimText>Magnesium (MG) shows 46% UniProt apo coverage in Subset 2, more than double the 22% seen for zinc, and also higher than calcium (35%), suggesting magnesium binding sites are easier to capture in apo form.</ahoj:claimText>
    <ahoj:sourceText>Table 2: MG has 1760 apo-paired UniProt ACs out of 3852 total (46% coverage), compared to ZN at 22% and CA at 35%.</ahoj:sourceText>
  </rdf:Description>

  <!-- ATP_ligand -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P067">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P067: ATP_ligand - has_higher_apo_coverage_than - Zinc_ligand</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/ATP_ligand"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/has_higher_apo_coverage_than"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Zinc_ligand"/>
    <ahoj:claimText>ATP shows 47% UniProt apo coverage in Subset 2, more than double the 22% seen for zinc, reflecting the biological importance and structural availability of nucleotide-binding site apo forms.</ahoj:claimText>
    <ahoj:sourceText>Table 2: ATP has 427 apo-paired UniProt ACs out of 916 total (47% coverage), structures 48%, chains 42%, sites 39%.</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P068">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P068: ATP_ligand - can_support - Drug_design</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/ATP_ligand"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/can_support"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Drug_design"/>
    <ahoj:claimText>ATP-binding pockets with 47% apo coverage in Subset 2 represent important drug design targets, as kinase inhibitors frequently compete with ATP; having paired apo structures supports docking studies.</ahoj:claimText>
    <ahoj:sourceText>These results can be used to train and evaluate predictors, discover potentially druggable proteins, and reveal protein- and ligand-specific relationships that were previously obscured by intermittent or partial data.</ahoj:sourceText>
  </rdf:Description>

  <!-- Druggable_proteome -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P069">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P069: Druggable_proteome - can_be_used_to_detect - Cryptic_binding_site</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Druggable_proteome"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/can_be_used_to_detect"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Cryptic_binding_site"/>
    <ahoj:claimText>Expanding the druggable proteome requires revealing binding sites normally obscured by conformational changes between apo and holo states; AHoJ-DB directly supports this goal.</ahoj:claimText>
    <ahoj:sourceText>In the field of drug target identification, there are ongoing efforts to expand the druggable proteome by revealing binding sites that are normally obscured by conformational changes that occur between the apo and holo states.</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P070">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P070: Druggable_proteome - requires - Apo_holo_pair</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Druggable_proteome"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/requires"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Apo_holo_pair"/>
    <ahoj:claimText>Identifying druggable proteins that are not readily captured in their apo form requires systematic apo-holo pair data, since the apo state reveals pocket accessibility without the bias of a bound ligand.</ahoj:claimText>
    <ahoj:sourceText>These results can be used to train and evaluate predictors, discover potentially druggable proteins, and reveal protein- and ligand-specific relationships that were previously obscured by intermittent or partial data.</ahoj:sourceText>
  </rdf:Description>

  <!-- Holo_form -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P071">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P071: Holo_form - is_biased_toward - PDB</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Holo_form"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/is_biased_toward"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/PDB"/>
    <ahoj:claimText>The PDB is inherently biased toward holo structures: holo entries outnumber apo by 95-100% across all subsets, and holo structures dominate PDB codes, chains, and pocket counts.</ahoj:claimText>
    <ahoj:sourceText>The average number of pockets, structures, and chains per entry is consistently higher for holo states — 95% to 100% difference — throughout all subsets compared to apo, indicating an inherent bias within the PDB towards holo structures.</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P072">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P072: Holo_form - often_relies_on - Drug_design</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Holo_form"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/often_relies_on"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Drug_design"/>
    <ahoj:claimText>Docking and drug design studies often consider only single holo structures, which are for the most part rigid, thereby ignoring conformational diversity of the binding site.</ahoj:claimText>
    <ahoj:sourceText>Nevertheless, docking or drug design studies often still consider only single protein structures in their holo form, which are for the most part rigid.</ahoj:sourceText>
  </rdf:Description>

  <!-- Crystallographic_artifact -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P073">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P073: Crystallographic_artifact - may_affect - Binding_pocket</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Crystallographic_artifact"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/may_affect"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Binding_pocket"/>
    <ahoj:claimText>Even crystallographic agents or crystal packing contacts detected near a pocket are treated as valid ligands in AHoJ-DB, because they affect local pocket geometry regardless of biological relevance.</ahoj:claimText>
    <ahoj:sourceText>It is worth noting that while we used biologically relevant interactions as starting points, we consider any detected ligand to be valid. The idea behind this is that even if these ligands are part of crystal packing contacts or crystallographic agents, they will affect the local geometry despite their questionable biological relevance.</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P074">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P074: Crystallographic_artifact - requires - Apo_holo_classification</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Crystallographic_artifact"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/requires"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Pocket_centric_classification"/>
    <ahoj:claimText>Filtering crystallographic artifacts from apo/holo classification can only be done by post-processing: parsing results and discarding ligands that appear in lists of known crystallographic agents, beyond the scope of the initial classification.</ahoj:claimText>
    <ahoj:sourceText>Modifications and filtering on these detected ligands may only be done by parsing the results and discarding, for example, ligands that appear in lists of crystallographic artifacts.</ahoj:sourceText>
  </rdf:Description>

  <!-- AHoJ_DB additional -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P075">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P075: AHoJ_DB - covers - Druggable_proteome</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_DB"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/covers"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Druggable_proteome"/>
    <ahoj:claimText>AHoJ-DB covers 27,983 proteins across 468,293 biologically relevant interactions, representing a large fraction of the PDB-accessible druggable proteome with paired apo-holo annotations.</ahoj:claimText>
    <ahoj:sourceText>We use a previously developed application (AHoJ) to perform a comprehensive search for apo-holo pairs for 468,293 biologically relevant protein-ligand interactions across 27,983 proteins.</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P076">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P076: AHoJ_DB - reports - Allosteric_factor</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_DB"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/reports"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Allosteric_factor"/>
    <ahoj:claimText>AHoJ-DB reports allosteric factors — PTM residues and ligands on relevant chains outside the query pocket — as part of its chain-level metric group, enabling allosteric effect studies.</ahoj:claimText>
    <ahoj:sourceText>Metrics that pertain to the protein structure chains that are involved in the formation of the mapped pocket — referred to as relevant chains — (i.e., TM-score, RMSD and allosteric factors like post-translationally modified (PTM) residues and ligands that occur within these chains).</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P077">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P077: AHoJ_DB - reports - SASA</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_DB"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/reports"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/SASA"/>
    <ahoj:claimText>AHoJ-DB reports SASA (solvent accessible surface area) as a pocket-level metric, computed for both query and candidate mapped pockets to enable surface accessibility comparisons.</ahoj:claimText>
    <ahoj:sourceText>Pocket metrics: number of residues successfully mapped on the SEQRES, number of residues that are observed in the structure, solvent accessible surface area, molecular surface, volume, b-factor, radius of gyration, pocket RMSD.</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P078">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P078: AHoJ_DB - reports - Chain_RMSD</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_DB"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/reports"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Chain_RMSD"/>
    <ahoj:claimText>AHoJ-DB reports chain RMSD for relevant chains, computed by aligning the candidate relevant chains onto the query chains, as a global structural deviation metric complementing pocket RMSD.</ahoj:claimText>
    <ahoj:sourceText>Chain RMSD is calculated by aligning the apo and holo relevant chains onto the respective query chains — (30% difference between apo and holo).</ahoj:sourceText>
  </rdf:Description>

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P079">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P079: AHoJ_DB - has_apo_form_for - Protein_ligand_interaction</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_DB"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/has_apo_form_for"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Protein_ligand_interaction"/>
    <ahoj:claimText>In the full unfiltered AHoJ-DB, 230,269 out of 468,293 entries (49.2%) have at least one apo form, spanning 13,068 of 27,983 UniProt ACs (46.7%).</ahoj:claimText>
    <ahoj:sourceText>The number of entries that have at least one apo form in the entire unfiltered database is 230,269 out of 468,293 (49.2%), representing 13,068 out of 27,983 total UniProt ACs (46.7%).</ahoj:sourceText>
  </rdf:Description>

  <!-- Unobserved_residues additional -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P080">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P080: Unobserved_residues - requires - Subset2</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Unobserved_residues"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/requires"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Subset2"/>
    <ahoj:claimText>Subset 2 was specifically designed to eliminate unobserved residues from the analysis by requiring zero unobserved MBR, making pocket geometry comparisons fully grounded in observed electron density.</ahoj:claimText>
    <ahoj:sourceText>Subset 2: observed residues at 100% of MBR (zero tolerance for unobserved pocket residues), enabling more confident pocket-related observations.</ahoj:sourceText>
  </rdf:Description>

  <!-- Pocket_volume additional -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P081">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P081: Pocket_volume - varies_between - Apo_holo_pair</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Pocket_volume"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/varies_between"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Apo_holo_pair"/>
    <ahoj:claimText>Pocket volume is 29% smaller in apo vs holo in Subset 1 (111.32 vs 153.28 Å³) and 24% smaller in Subset 2, indicating consistent ligand-induced expansion of binding pockets.</ahoj:claimText>
    <ahoj:sourceText>Volume shows 29.11% difference (Subset 1: Apo avg 111.32, Holo avg 153.28 Å³) and 23.58% difference in Subset 2.</ahoj:sourceText>
  </rdf:Description>

  <!-- PDB additional -->

  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/P082">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>P082: PDB - contains multiple structures for - Conformational_variability</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/PDB"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/covers"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Conformational_variability"/>
    <ahoj:claimText>The PDB contains over 215,000 experimentally determined protein structures, many solved for the same protein under different conditions, encoding a rich source of conformational variability that AHoJ-DB systematically captures.</ahoj:claimText>
    <ahoj:sourceText>The PDB is our most valuable structural data resource, containing over 215,000 experimentally determined protein structures. Many of these structures belong to the same protein but are solved under different conditions or bind different non-protein molecules.</ahoj:sourceText>
  </rdf:Description>

