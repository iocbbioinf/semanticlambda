  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C003">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C003: Drug_design_and_docking - often rely on - Protein_structure</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Protein_structure"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/often_rely_on"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Drug_design_and_docking"/>
    <ahoj:claimText>The paper argues that docking and drug-design studies often still use mostly rigid holo structures. This can miss conformational diversity relevant to binding and prediction.</ahoj:claimText>
  </rdf:Description>
