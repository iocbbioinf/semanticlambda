  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C033">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C033: AHoJ_DB - reports - Structure_metrics</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Structure_metrics"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/reports"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_DB"/>
    <ahoj:claimText>AHoJ-DB reports metrics for protein chains involved in the mapped pocket, including TM-score, chain RMSD, and allosteric factors. These connect pocket changes to broader chain-level structure.</ahoj:claimText>
  </rdf:Description>
