  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C014">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C014: AHoJ_DB - uses structures from - PDB</rdfs:label>
