    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Manual_dataset_assembly"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/limits"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Manual_dataset_assembly"/>
    <ahoj:claimText>Manual curation can produce high-quality datasets but makes comprehensive and easily updatable apo-holo resources difficult. This motivates the large-scale automated approach of AHoJ-DB.</ahoj:claimText>
  </rdf:Description>
