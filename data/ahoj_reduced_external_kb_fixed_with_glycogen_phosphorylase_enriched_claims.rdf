    <rdfs:label>C038: AHoJ_DB - covers - Protein</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Protein"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/covers"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_DB"/>
    <ahoj:claimText>The processed interactions span 27,983 proteins. Protein identity is organized through UniProt accession assignments.</ahoj:claimText>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C078">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C078: AHoJ_DB_web_server - provides - AHoJ_DB_web_server</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_DB_web_server"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/provides"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_DB_web_server"/>
    <ahoj:claimText>The web server provides visualization of apo/holo results and structural superpositions. The figure on page 6 shows the interface with search results and detailed visualization.</ahoj:claimText>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C043">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C043: Filtered_subset - yielded - Dataset_size_statistic</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
