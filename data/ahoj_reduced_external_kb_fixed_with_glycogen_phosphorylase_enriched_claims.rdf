  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C049">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C049: Apo_pocket_in_filtered_subset - have smaller - Pocket_geometry_metric</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Pocket_geometry_metric"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/have_smaller"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Apo_pocket_in_filtered_subset"/>
    <ahoj:claimText>The paper reports that apo pockets appear smaller overall than holo pockets in Subset 2. This supports the idea that ligand binding may open or stabilize pocket geometry.</ahoj:claimText>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C010">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C010: AHoJ_DB - uses input interactions from - BioLiP2</rdfs:label>
