  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C058">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C058: Interface_binding_pocket - account for - Interface_site_statistic</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Interface_site_statistic"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/account_for"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Interface_binding_pocket"/>
    <ahoj:claimText>Using the 4.5 Å cutoff, the paper reports that approximately 24% of binding sites involve two or more chains. This makes interface pockets a substantial fraction of binding sites.</ahoj:claimText>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C060">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C060: Interface_binding_pocket - are often neglected or misrepresented in - Data_processing_workflow</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Data_processing_workflow"/>
