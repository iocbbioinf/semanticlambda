    <pred:occur_within rdf:resource="https://w3id.org/ahoj/entity/Mapped_candidate_pocket"/>
    <pred:occur_within rdf:resource="https://w3id.org/ahoj/entity/Relevant_chain"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C045">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C045: Filtered_subset - requires - Mapped_binding_residue_metric</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Mapped_binding_residue_metric"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/requires"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Filtered_subset"/>
    <ahoj:claimText>Subset 2 applies the same resolution and diffraction-method filters as Subset 1 but also requires all mapped binding residues to be observed. This enables more confident pocket-level geometric comparisons.</ahoj:claimText>
  </rdf:Description>
