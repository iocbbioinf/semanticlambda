    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Mapped_binding_residue_metric"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/are_also_sorted_by"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Candidate_structures"/>
    <ahoj:claimText>After mapped-residue coverage, filtered results are sorted by number of observed residues and then by resolution. This prioritizes structurally complete and higher-quality candidate pockets.</ahoj:claimText>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C106">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C106: AHoJ_DB_web_server - provides - Apo_holo_pair_visualizations</rdfs:label>
