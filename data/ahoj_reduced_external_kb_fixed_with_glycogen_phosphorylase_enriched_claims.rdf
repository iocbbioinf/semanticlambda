  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C030">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C030: Candidate_structures - are sorted by - Mapped_binding_residue_metric</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Mapped_binding_residue_metric"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/are_sorted_by"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Candidate_structures"/>
    <ahoj:claimText>Filtered candidate results are primarily sorted by the percentage of mapped binding residues. This favors candidates where the original pocket is more completely represented.</ahoj:claimText>
  </rdf:Description>
