  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C059">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C059: Interface_binding_pocket - account for - Interface_site_statistic</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Interface_site_statistic"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/account_for"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Interface_binding_pocket"/>
    <ahoj:claimText>The paper reports that about 9% of binding pockets involve multiple UniProt accessions, corresponding to heteromeric binding sites. These are a subset of multi-chain pockets.</ahoj:claimText>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C052">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C052: Ligand - influences - Ligand_apo_coverage</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Ligand_apo_coverage"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/influences"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Ligand"/>
    <ahoj:claimText>When entries are grouped by ligand, the fraction of sites with apo-paired entries varies strongly. This suggests that apo availability is ligand-dependent.</ahoj:claimText>
  </rdf:Description>
