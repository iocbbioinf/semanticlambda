  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C073">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C073: AHoJ_DB - can support - Binding_site_analysis_use_case</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Binding_site_analysis_use_case"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/can_support"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_DB"/>
    <ahoj:claimText>By collecting conformational variability across structures with identical or corresponding sequences, AHoJ-DB may support studies of folding dynamics. The paper links structural variability to sequence-independent folding behavior.</ahoj:claimText>
  </rdf:Description>
