    <rdfs:label>4 5 angstrom</rdfs:label>
    <rdfs:label>4.5 Å distance cutoff</rdfs:label>
    <skos:altLabel>4 5 angstrom</skos:altLabel>
    <skos:relatedMatch rdf:resource="http://edamontology.org/operation_2428"/>
    <skos:scopeNote>Distance cutoff participates in structural comparison/selection logic.</skos:scopeNote>
    <ahoj:mappedBy rdf:resource="https://w3id.org/ahoj/entity/External_KB_mapping_enrichment_2026_06_11"/>
    <ahoj:mergedEntityCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ahoj:mergedEntityCount>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C103">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
