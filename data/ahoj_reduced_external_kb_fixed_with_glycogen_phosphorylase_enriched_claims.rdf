    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Holo_pocket"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/can_justify"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Detected_ligand_near_pocket"/>
    <ahoj:claimText>The paper treats any detected ligand near the mapped pocket as valid for holo classification, even if the ligand may be crystallographic or not biologically relevant. The rationale is that such ligands can still affect local pocket geometry.</ahoj:claimText>
  </rdf:Description>
