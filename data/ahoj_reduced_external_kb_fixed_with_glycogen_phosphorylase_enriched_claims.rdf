  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C031">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C031: Candidate_structures - are also sorted by - Mapped_binding_residue_metric</rdfs:label>
