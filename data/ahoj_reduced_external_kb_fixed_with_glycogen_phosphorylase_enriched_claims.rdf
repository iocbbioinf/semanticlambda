  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C066">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C066: AHoJ_DB - can support - Structural_biology_use_case</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
