    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/requires_minimum_mapped_binding_residues_on_SEQRES"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_DB_input_selection"/>
    <ahoj:claimText>Candidate structures were processed only if at least 30% of the query pocket residues could be mapped onto the candidate SEQRES. Otherwise, the structure was not processed.</ahoj:claimText>
  </rdf:Description>
