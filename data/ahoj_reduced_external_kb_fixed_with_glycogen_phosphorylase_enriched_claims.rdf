    <skos:altLabel>Allosteric factors</skos:altLabel>
    <skos:altLabel>Orthosteric factors</skos:altLabel>
    <skos:relatedMatch rdf:resource="https://w3id.org/biolink/vocab/ChemicalEntity"/>
    <skos:scopeNote>Allosteric/orthosteric factors may include ligands and PTMs.</skos:scopeNote>
    <ahoj:mappedBy rdf:resource="https://w3id.org/ahoj/entity/External_KB_mapping_enrichment_2026_06_11"/>
