  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C041">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C041: Processed_binding_sites - often lack - Apo_pocket</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Apo_pocket"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/often_lack"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Processed_binding_sites"/>
    <ahoj:claimText>The paper concludes that less than half of the processed binding sites have an apo form in the PDB. This lack of apo structures may limit benchmark construction and model evaluation.</ahoj:claimText>
  </rdf:Description>
