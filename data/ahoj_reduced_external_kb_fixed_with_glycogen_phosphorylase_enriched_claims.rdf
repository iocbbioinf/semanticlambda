  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C042">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C042: Filtered_subset - applies - Resolution_threshold</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Resolution_threshold"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/applies"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Filtered_subset"/>
    <ahoj:claimText>Subset 1 includes structures with resolution 4.5 Å or better and only diffraction methods. It also requires 100% mapped binding residues on SEQRES but allows some mapped residues to be unobserved.</ahoj:claimText>
