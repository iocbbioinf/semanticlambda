  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C055">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C055: Ligand_apo_coverage - have very low - Ligand_apo_coverage</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Ligand_apo_coverage"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/have_very_low"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Ligand_apo_coverage"/>
    <ahoj:claimText>Fe4S4 iron-sulfur cluster binding sites show almost no apo-paired coverage. The paper suggests such ligand classes may correspond to pockets or structures that are difficult to resolve without the ligand.</ahoj:claimText>
  </rdf:Description>
