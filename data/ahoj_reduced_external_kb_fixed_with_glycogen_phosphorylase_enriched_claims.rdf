    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/BioLiP2"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/uses_input_interactions_from"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/AHoJ_DB"/>
    <ahoj:claimText>AHoJ-DB starts from biologically relevant protein-ligand interactions taken from the redundant set of BioLiP2. These interactions define the initial holo query sites.</ahoj:claimText>
  </rdf:Description>
