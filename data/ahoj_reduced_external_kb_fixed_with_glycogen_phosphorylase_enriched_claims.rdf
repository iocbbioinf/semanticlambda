  <rdf:Description rdf:about="https://w3id.org/ahoj/claim/C006">
    <rdf:type rdf:resource="https://w3id.org/ahoj/ontology/ClaimTriplet"/>
    <rdfs:label>C006: Apo_holo_classification - can be ambiguous for - Protein</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://w3id.org/ahoj/entity/Article_AHoJDB_2024"/>
    <ahoj:claimObject rdf:resource="https://w3id.org/ahoj/entity/Protein"/>
    <ahoj:claimPredicate rdf:resource="https://w3id.org/ahoj/predicate/can_be_ambiguous_for"/>
    <ahoj:claimSubject rdf:resource="https://w3id.org/ahoj/entity/Apo_holo_classification"/>
    <ahoj:claimText>Assigning apo or holo status to an entire chain can be misleading when the same chain contains multiple pockets. One site may be ligand-bound while another site is not.</ahoj:claimText>
  </rdf:Description>
